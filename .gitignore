__pycache__/
*.pyc
*.pyo
*.pyd
**/__pycache__/
**/*.pyc

# ── Database ─────────────────────────────────────────────
data/processed/
*.db

# ── Raw accident data (large) ────────────────────────────
data/raw/unfallatlas/

# ── macOS junk ───────────────────────────────────────────
.DS_Store
**/.DS_Store
data/.DS_Store
data/raw/.DS_Store
src/.DS_Store
outputs/.DS_Store

# ── VS Code ──────────────────────────────────────────────
.vscode/

# ── Environment files ────────────────────────────────────
.env
.env.*

# ── Notebooks ────────────────────────────────────────────
notebooks/

